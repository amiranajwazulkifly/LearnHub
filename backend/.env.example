# Rate limiting — requests per client IP per 15 minutes. The general limit is
# deliberately generous: one page load is several API calls, and a campus
# network can put a whole class behind one address.
# API_RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=20

# Set only when the API sits behind a reverse proxy or load balancer, to the
# number of proxy hops (usually 1). Unset, the proxy's address is used for
# every client and all users share one rate-limit bucket. Set when there is
# no proxy, clients can spoof their IP and bypass the limits.
# TRUST_PROXY=1
