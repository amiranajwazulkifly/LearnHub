# Optional — docker-compose.yml works with zero setup using the defaults
# baked into it (the same well-known local Supabase CLI demo secrets already
# used elsewhere in this repo, e.g. backend/.env.example). Copy this to
# `.env` only if you want to override something, e.g. for a production
# deployment (see DOCKER.md).

# Postgres superuser password, shared by db/storage/pg-meta/migrate/backend.
# POSTGRES_PASSWORD=postgres

# Secret for the demo Supabase ANON_KEY/SERVICE_ROLE_KEY JWTs used by
# storage-api. Only matters if you regenerate those keys to match.
# SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...

# This app's own auth (unrelated to the Supabase keys above — custom JWT,
# not Supabase Auth). Change this for any real deployment.
# JWT_SECRET=replace_with_a_long_random_secret
# JWT_EXPIRES_IN=30d

# Host ports — change any of these if they collide with something else
# already running on your machine.
# DB_PORT=54322
# SUPABASE_PUBLIC_PORT=54321
# BACKEND_PORT=5001
# FRONTEND_PORT=5175
# STUDIO_PORT=54323

# Production only (docker-compose.prod.yml) — your backend's public URL,
# baked into the frontend's static build at build time.
# VITE_API_BASE_URL=https://api.example.com/api
